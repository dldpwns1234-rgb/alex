; Engine configuration file.
; 회귀 용사 키우기 (가제) — 웹용 세로 화면 인크리멘탈 게임 (CLAUDE.md 기술 스택)

config_version=5

[application]

config/name="회귀 용사 키우기"
config/description="용사가 동료 파티와 함께 마왕군을 뚫고 나아가는 클리커 인크리멘탈 게임"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

; 순서가 곧 초기화 순서. Balance는 다른 모든 오토로드가 참조하므로 맨 앞이다
Balance="*res://autoload/balance.gd"
Num="*res://autoload/num.gd"
Prestige="*res://autoload/prestige.gd"
; 환생은 Game.reset()이 시작 스테이지를 물어보므로 Game보다 앞에
Rebirth="*res://autoload/rebirth.gd"
Party="*res://autoload/party.gd"
Skills="*res://autoload/skills.gd"
Training="*res://autoload/training.gd"
Promotions="*res://autoload/promotions.gd"
Game="*res://autoload/game.gd"
; 업적은 Game·Party·Prestige·Skills의 시그널을 받으므로 그 뒤에, 불러올 때 부르는 Save보다는 앞에
Achievements="*res://autoload/achievements.gd"
Equipment="*res://autoload/equipment.gd"
; 자동화는 Game·Prestige·Rebirth의 시그널을 받고 Save가 불러온다
Automation="*res://autoload/automation.gd"
; 도전 판은 Game·Prestige·Rebirth의 시그널을 받고 Party·Skills·Game·Equipment·Prestige가 제한을 묻는다
Challenges="*res://autoload/challenges.gd"
; 시련의 탑은 Game·Equipment·Rebirth·Achievements를 쓰고 Save가 불러온다
Tower="*res://autoload/tower.gd"
Save="*res://autoload/save.gd"

[display]

; 기준 해상도 720×1280 세로. 폭을 기준으로 맞추고 세로는 남는 만큼 늘어난다
window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[gui]

; tools/make_theme.gd가 만든 전체 테마. 팝업 창까지 같은 모양을 쓴다
theme/custom="res://assets/ui/theme.tres"
; 고도 기본 폰트에는 한글이 없다. 웹에서는 시스템 폰트 대체도 안 되므로 직접 넣는다
theme/custom_font="res://assets/fonts/NotoSansKR-Regular.ttf"
; 폰 화면에서 읽히는 크기
theme/default_font_size=28

[rendering]

; 화면 바탕색. 테마(tools/make_theme.gd)의 어두운 보라와 맞춘다
environment/defaults/default_clear_color=Color(0.133, 0.118, 0.188, 1)
; Compatibility 렌더러: 웹 익스포트 조건
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
